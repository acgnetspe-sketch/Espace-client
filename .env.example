# Copier ce fichier en « .env » puis remplir les valeurs (ne jamais publier .env).
# Où les trouver : tableau de bord Supabase › Project Settings › API.

# Adresse du projet Supabase, par exemple https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clé publique « anon » (ou « publishable »). Elle est faite pour le navigateur :
# la sécurité repose sur les règles Row Level Security, pas sur le secret de cette clé.
# Ne JAMAIS mettre ici la clé « service_role » (ou « secret ») : elle contourne toutes les règles.
VITE_SUPABASE_ANON_KEY=

# Site de DÉMONSTRATION uniquement (projet Supabase séparé, données fictives) :
# affiche le bandeau « Démonstration » et la connexion par mot de passe aux comptes fictifs.
# Ne jamais mettre cette valeur sur le site de production.
# VITE_MODE_DEMO=true
